{
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": { 
      "~/*": ["app/*"], 
      "@/*": ["app/*"],
      "~/server/*": ["server/*"]
    },
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["vite/client", "vitest", "node", "nuxt"]
  },
  "include": [
    ".nuxt/**/*.d.ts",
    ".nuxt/**/*.ts",
    "nuxt.config.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "app/**/*.vue",
    "server/**/*.ts",
    "server/**/*.d.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "types/**/*.d.ts"
  ],
  "exclude": ["dist", ".output", "node_modules"]
}